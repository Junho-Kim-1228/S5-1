{
  "schema_version": 4,
  "pipeline": {
    "mode": "anoma_then_yolo",
    "display_name": "2단계 (Anoma -> YOLO)",
    "stage1": "anoma",
    "stage2": "yolo",
    "skip_yolo_when_stage1_normal": true,
    "required_models": [
      "mask",
      "anoma",
      "yolo"
    ]
  },
  "input": {
    "image_format": "bmp"
  },
  "output": {
    "format": "json",
    "schema": "detections_v1"
  },
  "auto_review": {
    "enabled": true,
    "policy_version": "auto_review_v1",
    "anoma_normal_threshold_multiplier": 0.5,
    "anoma_defect_threshold_multiplier": 2.0,
    "yolo_box_min_confidence": 0.85,
    "audit_sample_rate": 0.1
  },
  "mask": {
    "model": "models/mask.onnx",
    "input_size": 512,
    "resize_mode": "letterbox",
    "image_mean": [0.485, 0.456, 0.406],
    "image_std": [0.229, 0.224, 0.225],
    "confidence_percentile": 99.5,
    "confidence_threshold": 0.5,
    "mask_threshold": 0.3,
    "min_component_area": 64,
    "morph_open_kernel": 0,
    "morph_close_kernel": 0,
    "outer_recover_kernel": 0,
    "keep_largest_component": true,
    "preserve_inner_holes": true,
    "min_hole_area": 64
  },
  "yolo": {
    "model": "models/yolo.onnx",
    "imgsz": 1280,
    "letterbox": true,
    "conf_thres": 0.25,
    "iou_thres": 0.45,
    "max_det": 300,
    "class_map": {
      "dent": 0,
      "loose": 1
    }
  },
  "anoma": {
    "model": "models/anoma.onnx",
    "mode": "stretch",
    "input_size": 448,
    "score_thres": 0.02454194,
    "crop_padding_px": 0
  }
}
