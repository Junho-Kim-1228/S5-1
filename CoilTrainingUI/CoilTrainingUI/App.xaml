<Application x:Class="CoilTrainingUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CoilTrainingUI.Converters"
             StartupUri="UI/MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:ImageStatusToColorConverter x:Key="ImageStatusToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
