<Window x:Class="CoilTrainingUI.BatchManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배치 관리"
        Width="1120"
        Height="700"
        MinWidth="840"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="배치 라이브러리" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="배치를 가져오거나 정리하고, 선택한 데이터로 학습을 시작할 수 있습니다."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="SummaryTextBlock"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Text="배치 목록 로딩 중..."/>
        </StackPanel>

        <DataGrid x:Name="BatchGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="선택"
                                        Width="60"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="배치명"
                                    Width="220"
                                    IsReadOnly="True"
                                    Binding="{Binding BatchId}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="ToolTip" Value="{Binding BatchId}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="폴더명"
                                    Width="180"
                                    IsReadOnly="True"
                                    Binding="{Binding BatchKey}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="ToolTip" Value="{Binding BatchKey}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="이미지 수"
                                    Width="80"
                                    IsReadOnly="True"
                                    Binding="{Binding ItemCount}"/>
                <DataGridTextColumn Header="생성일"
                                    Width="170"
                                    IsReadOnly="True"
                                    Binding="{Binding CreatedAtText}"/>
                <DataGridTemplateColumn Header="숨김"
                                        Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="HiddenCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="숨김 상태"
                                    Width="160"
                                    IsReadOnly="True"
                                    Binding="{Binding HiddenReasonText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2"
                   Margin="0,16,0,0"
                   ItemWidth="160">
            <Button Content="배치 폴더 열기"
                    Margin="0,0,8,8"
                    Click="OpenInboxFolder_Click"/>
            <Button Content="배치 불러오기..."
                    Margin="0,0,8,8"
                    Click="ImportBatch_Click"/>
            <Button Content="배치명 변경"
                    Margin="0,0,8,8"
                    Click="RenameSelected_Click"/>
            <Button Content="선택 해제"
                    Margin="0,0,8,8"
                    Click="ClearSelection_Click"/>
            <Button Content="선택 배치 학습"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,8"
                    Click="TrainSelected_Click"/>
            <Button Content="병합 배치 생성"
                    Margin="0,0,8,8"
                    Click="MergeSelected_Click"/>
            <Button Content="선택 숨김"
                    Margin="0,0,8,8"
                    Click="HideSelected_Click"/>
            <Button Content="선택 삭제"
                    Style="{StaticResource DangerButtonStyle}"
                    Margin="0,0,8,8"
                    Click="DeleteSelected_Click"/>
        </WrapPanel>
    </Grid>
</Window>
