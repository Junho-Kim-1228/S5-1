<Window x:Class="CoilTrainingUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coil Training UI"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="700"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <DockPanel>

        <!-- 상단 메뉴 -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="Dataset">
                <!-- 나중에 Open Folder 같은 거 들어갈 자리 -->
            </MenuItem>

            <MenuItem Header="Labeling">
                <MenuItem Header="Apply Predictions to Labels (Current Image)"
                          Click="ApplyPredictionsToLabelsCurrentImage_Click"/>
            </MenuItem>

            <MenuItem Header="Training">
                <MenuItem Header="Load Local Input"
                          Click="LoadLocalInput_Click"/>

                <MenuItem Header="Import Inference Batch..."
                          Click="ImportInferenceBatch_Click"/>

                <MenuItem Header="Load Imported Batch..."
                          Click="LoadImportedBatch_Click"/>

                <Separator/>

                <MenuItem Header="Export Anomaly Dataset"
                          Click="ExportAnomalyDataset_Click"/>

                <MenuItem Header="Train All (YOLO + Anomalib)" 
                          Click="TrainAll_Click"/>
                <Separator/>
                <MenuItem Header="Build Package Only" 
                          Click="BuildPackageOnly_Click"/>

            </MenuItem>

            <MenuItem Header="Model">
                <!-- ONNX 관련 메뉴 예정 -->
            </MenuItem>

        </Menu>


        <!-- 하단 로그 영역 -->
        <Border DockPanel.Dock="Bottom" Height="150" Background="#111">
            <TextBox Text="Log Output..."
                     Foreground="LightGray"
                     Background="#111"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 메인 영역 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <!-- 좌측 -->
                <ColumnDefinition Width="*"/>
                <!-- 중앙 -->
                <ColumnDefinition Width="190"/>
                <!-- 우측 -->
            </Grid.ColumnDefinitions>

            <!-- 좌측: 데이터 탐색 -->
            <Border Grid.Column="0" Background="#333" Padding="3">
                
                <DockPanel>

                    <TextBlock Text="Dataset"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               DockPanel.Dock="Top"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Background="#444">
                        <TextBlock x:Name="TotalCountText" Text="Total: 0" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock x:Name="NormalCountText" Text="Normal: 0" Foreground="#A0FFA0" FontSize="12"/>
                        <TextBlock x:Name="DefectCountText" Text="Defect: 0" Foreground="#FFA0A0" FontSize="12"/>
                    </StackPanel>

                    <ListBox x:Name="ImageListBox"
                        SelectionChanged="ImageListBox_SelectionChanged">


                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0"
                                        Margin="0,0,0,1"
                                        CornerRadius="4"
                                        Background="{Binding ., 
                                                     Converter={StaticResource ImageStatusToColorConverter}}">

                                    <StackPanel Orientation="Vertical">

                                        <!-- 파일명 -->
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="Black"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,2"/>

                                        <!-- 상태 표시 -->
                                        <StackPanel Orientation="Horizontal">
                                            <!-- YOLO -->
                                            <TextBlock Text="YOLO:"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#606060"/>

                                            <TextBlock Text="{Binding YoloStatusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding HasLabel,
                                                                    Converter={StaticResource YoloStatusColorConverter}}"
                                                       Margin="4,0,12,0"/>

                                            <!-- Anomaly -->
                                            <TextBlock Text="Anomaly:"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#606060"/>

                                            <TextBlock Text="{Binding AnomalyStatusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding IsNormal,
                                                                    Converter={StaticResource AnomalyStatusColorConverter}}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                </DockPanel>
            </Border>

            <!-- 중앙: 이미지 뷰어 -->
            <Border Grid.Column="1" Background="#222">
                <ScrollViewer x:Name="ImageScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="ImageCanvas_MouseWheel">

                    <Grid x:Name="DisplayGrid" RenderTransformOrigin="0,0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.RenderTransform>

                        <Image x:Name="MainImage"
                                   Stretch="None"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <Canvas x:Name="ImageCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Width="{Binding ElementName=MainImage, Path=ActualWidth}"
                                    Height="{Binding ElementName=MainImage, Path=ActualHeight}"
                    
                                    PreviewMouseLeftButtonDown="ImageCanvas_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ImageCanvas_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ImageCanvas_PreviewMouseLeftButtonUp"

                                    MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown"
                                    MouseMove="ImageCanvas_MouseMove"
                                    MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 우측: 속성 패널 -->
            <Border Grid.Column="2" Background="#F5F5F5" Padding="10">
                <StackPanel>

                    <TextBlock Text="Properties"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                    <!-- 선택된 박스 클래스 -->
                    <TextBlock Text="Class"
                   Margin="0,10,0,5"/>

                    <ComboBox x:Name="ClassComboBox"
                  SelectionChanged="ClassComboBox_SelectionChanged"
                  IsEnabled="False">
                        <ComboBoxItem Content="dent"/>
                        <ComboBoxItem Content="loose"/>
                    </ComboBox>

                    <!-- 확대/축소 버튼 -->
                    <TextBlock Text="View"
                   FontWeight="Bold"
                   Margin="0,20,0,5"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋" Width="40" Click="ZoomIn_Click"/>
                        <Button Content="－" Width="40" Margin="5,0,0,0" Click="ZoomOut_Click"/>
                    </StackPanel>

                    <GroupBox Header="Anomaly Label">
                        <StackPanel>
                            <RadioButton x:Name="NormalRadio"
                                           Content="Normal"
                                           Checked="NormalRadio_Checked"/>
                            <RadioButton x:Name="AbnormalRadio"
                                           Content="Abnormal"
                                           Checked="AbnormalRadio_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="RoiTypeGroupBox"
                              Header="ROI Type"
                              Margin="0,15,0,0"
                              IsEnabled="False">
                        <StackPanel>
                            <RadioButton Content="None"
                                         Tag="None"
                                         Checked="RoiTypeRadio_Checked"/>

                            <RadioButton Content="Type A"
                                         Tag="A"
                                         Checked="RoiTypeRadio_Checked"/>

                            <RadioButton Content="Type B"
                                         Tag="B"
                                         Checked="RoiTypeRadio_Checked"/>

                            <RadioButton Content="Type C"
                                         Tag="C"
                                         Checked="RoiTypeRadio_Checked"/>
                        </StackPanel>
                        
                    </GroupBox>
                    <CheckBox x:Name="ShowRoiCheckBox"
                                Content="Show ROI Mask"
                                IsEnabled="False"
                                Checked="ShowRoiCheckBox_Checked"
                                Unchecked="ShowRoiCheckBox_Unchecked"/>

                    <CheckBox x:Name="ShowPredictionCheckBox"
                              Content="Show Prediction Overlay"
                              Margin="0,8,0,0"
                              IsChecked="False"
                              Checked="ShowPredictionCheckBox_Checked"
                              Unchecked="ShowPredictionCheckBox_Unchecked"/>

                </StackPanel>
            </Border>


        </Grid>

    </DockPanel>
</Window>
