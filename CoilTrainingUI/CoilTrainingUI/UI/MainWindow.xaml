<Window x:Class="CoilTrainingUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coil Training Studio"
        Width="1500" Height="1140"
        MinWidth="1120" MinHeight="720"
        Background="{StaticResource AppBackgroundBrush}"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#273449"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#3D4C63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#334155"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 상단 메뉴 -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="Batch">
                <MenuItem Header="배치 가져오기..."
                          Click="ImportBatch_Click"/>
                <MenuItem Header="폴더에서 배치 생성..."
                          Click="CreateBatchFromFolder_Click"/>
                <MenuItem Header="배치 관리..."
                          Click="BatchManagement_Click"/>
                <MenuItem Header="training_inbox 열기"
                          Click="OpenTrainingInbox_Click"/>
            </MenuItem>

            <MenuItem Header="Review">
                <MenuItem Header="필터 전체 Anoma 판정 수락"
                          Click="AcceptFilteredAnomaDecisions_Click"/>
                <MenuItem x:Name="PreLabelBatchMenuItem"
                          Header="필터된 이미지 AI 박스 전체 수락"
                          Click="ApplyPredictionsToLabelsFilteredImages_Click"/>
                <MenuItem x:Name="ShowReviewQueueMenuItem"
                          Header="미검수·검수 중 목록 보기"
                          Click="ShowReviewQueue_Click"/>
            </MenuItem>

            <MenuItem x:Name="TrainMenuItem" Header="Train">
                <MenuItem Header="학습 파이프라인">
                    <MenuItem x:Name="TrainPipelineAnomaThenYoloMenuItem"
                              Header="2단계 (Anoma → YOLO)"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="TrainPipelineAnomaThenYolo_Click"/>
                    <MenuItem x:Name="TrainPipelineAnomaOnlyMenuItem"
                              Header="Anoma만"
                              IsCheckable="True"
                              Click="TrainPipelineAnomaOnly_Click"/>
                    <MenuItem x:Name="TrainPipelineYoloOnlyMenuItem"
                              Header="YOLO만"
                              IsCheckable="True"
                              Click="TrainPipelineYoloOnly_Click"/>
                </MenuItem>

                <MenuItem Header="YOLO 학습 방식">
                    <MenuItem x:Name="YoloTrainFreshMenuItem"
                              Header="YOLO26n 기본 가중치로 새 학습"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="YoloTrainFresh_Click"/>
                    <MenuItem x:Name="YoloTrainFineTuneMenuItem"
                              Header="기존 best.pt로 파인튜닝..."
                              IsCheckable="True"
                              Click="YoloTrainFineTune_Click"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="현재 파이프라인 학습 실행" 
                          Click="TrainAll_Click"/>

                <MenuItem Header="패키지만 다시 생성" 
                          Click="BuildPackageOnly_Click"/>

                <Separator/>

                <MenuItem Header="모델 관리..."
                          Click="ModelManagement_Click"/>
            </MenuItem>

            <MenuItem Header="Automation">
                <MenuItem x:Name="AutomationEnabledMenuItem"
                          Header="로컬 자동화 사용"
                          IsCheckable="True"
                          Click="AutomationEnabled_Click"/>
                <MenuItem Header="ExchangeRoot 선택..." Click="SelectExchangeRoot_Click"/>
                <MenuItem Header="기본 ExchangeRoot로 재설정" Click="ResetExchangeRoot_Click"/>
                <Separator/>
                <MenuItem x:Name="ExchangeRootMenuItem" Header="ExchangeRoot" IsEnabled="False"/>
                <MenuItem Header="지금 동기화" Click="AutomationReconcileNow_Click"/>
            </MenuItem>

        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#172033" Foreground="White" Padding="8,3">
            <StatusBarItem><TextBlock x:Name="AutomationStatusText" Text="로컬 자동화 준비 중"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="ModelPublishStatusText" Text="모델 발행 이력 없음"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="ModelActivationStatusText" Text="모델 적용 요청 없음"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AutomationPathWarningText" Foreground="#FBBF24"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 메인 영역 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <!-- 좌측 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 데이터 탐색 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="#253248"
                    BorderThickness="0,0,1,0"
                    Padding="16,14">
                
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,14">
                        <TextBlock Text="DATASET WORKSPACE"
                                   Foreground="#60A5FA"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                        <TextBlock Text="검수 데이터"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="학습 후보를 탐색하고 검수 상태를 관리합니다"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource SidebarCardStyle}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button x:Name="RefreshImageListButton"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        ToolTip="이미지 목록 새로고침"
                                        Click="RefreshImageList_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               Text="&#xE72C;"/>
                                </Button>
                                <TextBlock Text="검수 현황"
                                           Foreground="#F8FAFC"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <WrapPanel Margin="0,0,0,7">
                                <TextBlock x:Name="TotalCountText"
                                           Text="전체 0"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0"/>
                                <TextBlock x:Name="VisibleCountText"
                                           Text="필터 후 0"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,1"/>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="UnreviewedCountText" Grid.Row="0" Grid.Column="0" Text="미검수 0" Foreground="#FBBF24" FontSize="11" Margin="0,1,8,2"/>
                                <TextBlock x:Name="ReviewingCountText" Grid.Row="0" Grid.Column="1" Text="검수 중 0" Foreground="#7DD3FC" FontSize="11" Margin="0,1,0,2"/>
                                <TextBlock x:Name="ConfirmedNormalCountText" Grid.Row="1" Grid.Column="0" Text="정상 확정 0" Foreground="#86EFAC" FontSize="11" Margin="0,1,8,2"/>
                                <TextBlock x:Name="ConfirmedDefectCountText" Grid.Row="1" Grid.Column="1" Text="불량 확정 0" Foreground="#FCA5A5" FontSize="11" Margin="0,1,0,2"/>
                                <TextBlock x:Name="ExcludedCountText" Grid.Row="2" Grid.ColumnSpan="2" Text="학습 사용 OFF 0" Foreground="#CBD5E1" FontSize="11" Margin="0,1,0,0"/>
                            </Grid>

                            <Expander Header="학습 상세"
                                      IsExpanded="False"
                                      Margin="0,7,0,0"
                                      Padding="0,3,0,0"
                                      FontSize="11">
                                <StackPanel Margin="2,4,0,0">
                                    <TextBlock x:Name="AutoAcceptedCountText" Text="AI 자동수락 0" Foreground="#B9F6CA" FontSize="11"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="AnomaTrainEligibleCountText" Text="Anoma 학습 0" Foreground="#86EFAC" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="AnomaEvalEligibleCountText" Text="Anoma 평가 0" Foreground="#FCA5A5" FontSize="11"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock x:Name="YoloPositiveEligibleCountText" Text="YOLO 양성 0" Foreground="#7DD3FC" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="YoloBackgroundCandidateCountText" Text="YOLO 배경 후보 0" Foreground="#BAE6FD" FontSize="11"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="YoloExcludedNoBoxCountText" Text="YOLO 박스 없는 불량 제외 0" Foreground="#FCD34D" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="YoloLowConfidenceBoxReviewCountText" Text="YOLO 저신뢰 박스 검수 필요 0" Foreground="#FDBA74" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Expander DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Padding="8,6"
                              Background="#172033"
                              BorderBrush="{StaticResource SidebarBorderBrush}"
                              BorderThickness="1"
                              Foreground="White"
                              Header="색상 안내"
                              IsExpanded="False">
                        <WrapPanel Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" ToolTip="정상 판정 확정">
                                <Border Width="9" Height="9" Background="#DCFFE1" Margin="0,2,4,0"/>
                                <TextBlock Text="정상" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" ToolTip="불량 판정 및 박스 검수 완료">
                                <Border Width="9" Height="9" Background="#FFDCDC" Margin="0,2,4,0"/>
                                <TextBlock Text="불량 완료" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" ToolTip="불량 판정 확정, 박스 검수 필요">
                                <Border Width="9" Height="9" Background="#FFE2B3" Margin="0,2,4,0"/>
                                <TextBlock Text="박스 검수" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" ToolTip="아직 검수하지 않음">
                                <Border Width="9" Height="9" Background="#FFF7DC" Margin="0,2,4,0"/>
                                <TextBlock Text="미검수" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,3" ToolTip="검수 진행 중">
                                <Border Width="9" Height="9" Background="#DCF0FF" Margin="0,2,4,0"/>
                                <TextBlock Text="검수 중" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3" ToolTip="판정은 유지하고 학습 사용만 OFF">
                                <Border Width="9" Height="9" Background="#E1E1E1" Margin="0,2,4,0"/>
                                <TextBlock Text="학습 OFF" Foreground="#E8E8E8" FontSize="10"/>
                            </StackPanel>
                        </WrapPanel>
                    </Expander>

                    <Expander DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              Padding="8"
                              Background="{StaticResource SidebarSurfaceBrush}"
                              BorderBrush="{StaticResource SidebarBorderBrush}"
                              BorderThickness="1"
                              Foreground="White"
                              Header="필터 및 데이터 품질"
                              IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="이미지명 검색" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <TextBox x:Name="ImageNameFilterTextBox"
                                     Margin="6,2,6,6"
                                     MinWidth="220"
                                     TextChanged="ImageNameFilterTextBox_TextChanged"/>

                            <TextBlock Text="배치" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <ComboBox x:Name="BatchFilterComboBox"
                                      Margin="6,2,6,6"
                                      MinWidth="220"
                                      SelectionChanged="BatchFilterComboBox_SelectionChanged"/>

                            <TextBlock Text="상태" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="StatusConfirmedNormalCheckBox"
                                          Content="확정 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusConfirmedDefectCheckBox"
                                          Content="확정 불량"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusAiNormalCheckBox"
                                          Content="AI 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusAiDefectCheckBox"
                                          Content="AI 불량"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="불량 유형" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="DefectTypeNormalCheckBox"
                                          Content="정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeDentCheckBox"
                                          Content="찍힘(dent)"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeLooseCheckBox"
                                          Content="풀림(loose)"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeNoLabelCheckBox"
                                          Content="라벨없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="사용자 검수 상태" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="ReviewUnreviewedCheckBox"
                                          Content="미검수"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewReviewingCheckBox"
                                          Content="검수 중"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewConfirmedNormalCheckBox"
                                          Content="정상 확정"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewConfirmedDefectCheckBox"
                                          Content="불량 확정"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewExcludedCheckBox"
                                          Content="학습 OFF"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="데이터 품질" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="QualityHealthyCheckBox"
                                          Content="데이터 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingInferCheckBox"
                                          Content="infer 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityInferParseFailedCheckBox"
                                          Content="infer 파싱 실패"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingStateCheckBox"
                                          Content="state 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingRawCheckBox"
                                          Content="raw 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <ListBox x:Name="ImageListBox"
                             Margin="0,2,0,0"
                             PreviewMouseWheel="ImageListBox_PreviewMouseWheel"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="ImageListBox_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="1"
                                        Margin="0"
                                        CornerRadius="9"
                                        ToolTip="{Binding StatusColorMeaningText}"
                                        HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{Binding ., Converter={StaticResource ImageStatusToColorConverter}}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Vertical" Margin="9,7">
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="#171717"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding BatchName, StringFormat='배치  {0}'}"
                                                   FontSize="10"
                                                   Foreground="#888888"
                                                   Margin="0,1,0,4"/>
                                        <TextBlock Text="{Binding AiAnomaSummaryText}" FontSize="11" Foreground="#444444"/>
                                        <TextBlock Text="{Binding AiYoloSummaryText}" FontSize="11" Foreground="#444444"/>
                                        <TextBlock Margin="0,3,0,0" FontSize="12">
                                            <Run Text="사용자  "/>
                                            <Run Text="{Binding UserDecisionText}" FontWeight="Bold"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding UserDecisionSourceText}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11">
                                            <Run Text="박스  "/>
                                            <Run Text="{Binding BoxReviewStatusText}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#1B5E20">
                                            <Run Text="학습  "/>
                                            <Run Text="{Binding TrainingEligibilityText}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TrainingExclusionReasonText}"
                                                   FontSize="10"
                                                   Foreground="#A33A00"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                </DockPanel>
            </Border>

            <!-- 중앙: 이미지 뷰어 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Margin="16,16,16,8"
                    Background="{StaticResource ViewerBrush}"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <ScrollViewer x:Name="ImageScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="ImageCanvas_MouseWheel"
                  SizeChanged="ImageScrollViewer_SizeChanged"
                  ScrollChanged="ImageScrollViewer_ScrollChanged">

                    <Grid x:Name="DisplayGrid" RenderTransformOrigin="0,0">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.LayoutTransform>

                        <Image x:Name="MainImage"
                                   Stretch="None"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <Canvas x:Name="ImageCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Width="{Binding ElementName=MainImage, Path=ActualWidth}"
                                    Height="{Binding ElementName=MainImage, Path=ActualHeight}"
                    
                                    PreviewMouseLeftButtonDown="ImageCanvas_PreviewMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="ImageCanvas_PreviewMouseRightButtonDown"
                                    PreviewMouseMove="ImageCanvas_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ImageCanvas_PreviewMouseLeftButtonUp"
                                    PreviewMouseRightButtonUp="ImageCanvas_PreviewMouseRightButtonUp"
                                    LostMouseCapture="ImageCanvas_LostMouseCapture"

                                    MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown"
                                    MouseMove="ImageCanvas_MouseMove"
                                    MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 하단: 속성 패널 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="16,8,16,16"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="박스 클래스" Style="{StaticResource SectionLabelStyle}"/>
                        <ComboBox x:Name="ClassComboBox"
                                  SelectionChanged="ClassComboBox_SelectionChanged"
                                  IsEnabled="False"
                                  Width="140">
                            <ComboBoxItem Content="dent"/>
                            <ComboBoxItem Content="loose"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="이미지 보기" Style="{StaticResource SectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋" Width="40" Style="{StaticResource CompactButtonStyle}" Click="ZoomIn_Click"/>
                            <Button Content="－" Width="40" Style="{StaticResource CompactButtonStyle}" Margin="5,0,0,0" Click="ZoomOut_Click"/>
                            <Button Content="맞춤" Width="64" Style="{StaticResource CompactButtonStyle}" Margin="5,0,0,0" Click="ResetZoom_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Column="2" Header="Anoma 판정" Margin="0,0,18,0">
                        <StackPanel>
                            <RadioButton x:Name="NormalRadio"
                                         Content="Normal"
                                         Checked="NormalRadio_Checked"/>
                            <RadioButton x:Name="AbnormalRadio"
                                         Content="Abnormal"
                                         Checked="AbnormalRadio_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <WrapPanel>
                            <Button x:Name="AcceptAiDecisionButton"
                                    Content="Anoma 판정 수락"
                                    Margin="0,0,6,5"
                                    Click="AcceptAiDecision_Click"/>
                            <Button x:Name="AcceptPredictionBoxesButton"
                                    Content="YOLO 박스 수락"
                                    Margin="0,0,6,5"
                                    Click="AcceptPredictionBoxes_Click"/>
                            <Button x:Name="ConfirmBoxesButton"
                                    Content="박스 저장"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="추가·수정·삭제한 현재 박스를 최종 확정"
                                    Margin="0,0,6,5"
                                    Click="ConfirmBoxes_Click"/>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,5">
                                <TextBlock Text="학습 사용"
                                           VerticalAlignment="Center"
                                           Foreground="#333333"
                                           FontWeight="SemiBold"
                                           Margin="0,0,7,0"/>
                                <ToggleButton x:Name="TrainingUseToggleButton"
                                              Width="54"
                                              Height="28"
                                              IsChecked="True"
                                              IsEnabled="False"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}"
                                              ToolTip="현재 판정과 박스는 유지하고 학습 사용 여부만 변경"
                                              Click="TrainingUseToggle_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Width="54" Height="28">
                                                <Border x:Name="ToggleTrack"
                                                        Background="#B0BEC5"
                                                        CornerRadius="14"/>
                                                <Ellipse x:Name="ToggleThumb"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="3,0,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Fill="#F4F6F8"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleTrack"
                                                            Property="Background"
                                                            Value="#3498DB"/>
                                                    <Setter TargetName="ToggleThumb"
                                                            Property="HorizontalAlignment"
                                                            Value="Right"/>
                                                    <Setter TargetName="ToggleThumb"
                                                            Property="Margin"
                                                            Value="0,0,3,0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleTrack"
                                                            Property="Opacity"
                                                            Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ToggleTrack"
                                                            Property="Opacity"
                                                            Value="0.45"/>
                                                    <Setter TargetName="ToggleThumb"
                                                            Property="Opacity"
                                                            Value="0.65"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="OFF"/>
                                            <Setter Property="Foreground" Value="#707070"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TrainingUseToggleButton}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="ON"/>
                                                    <Setter Property="Foreground" Value="#1976B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <CheckBox x:Name="ShowPredictionCheckBox"
                                      Content="AI 예측 박스 표시"
                                      Margin="0,0,14,0"
                                      IsChecked="True"
                                      Checked="ShowPredictionCheckBox_Checked"
                                      Unchecked="ShowPredictionCheckBox_Unchecked"/>
                            <CheckBox x:Name="ShowRawCheckBox"
                                      Content="Show RAW"
                                      IsChecked="False"
                                      Checked="ShowRawCheckBox_Checked"
                                      Unchecked="ShowRawCheckBox_Unchecked"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>


        </Grid>

    </DockPanel>
</Window>
