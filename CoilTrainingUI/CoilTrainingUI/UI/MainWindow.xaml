<Window x:Class="CoilTrainingUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coil Training UI"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="700"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#6A6A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#5A5A5A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 상단 메뉴 -->

        <Menu DockPanel.Dock="Top">

            <MenuItem Header="Batch">
                <MenuItem Header="배치 가져오기..."
                          Click="ImportBatch_Click"/>
                <MenuItem Header="폴더에서 배치 생성..."
                          Click="CreateBatchFromFolder_Click"/>
                <MenuItem Header="배치 관리..."
                          Click="BatchManagement_Click"/>
                <MenuItem Header="training_inbox 열기"
                          Click="OpenTrainingInbox_Click"/>
            </MenuItem>

            <MenuItem Header="Review">
                <MenuItem Header="필터 전체 Anoma 판정 수락"
                          Click="AcceptFilteredAnomaDecisions_Click"/>
                <MenuItem x:Name="PreLabelBatchMenuItem"
                          Header="필터된 이미지 AI 박스 전체 수락"
                          Click="ApplyPredictionsToLabelsFilteredImages_Click"/>
                <MenuItem x:Name="ShowReviewQueueMenuItem"
                          Header="미검수·검수 중 목록 보기"
                          Click="ShowReviewQueue_Click"/>
            </MenuItem>

            <MenuItem Header="Train">
                <MenuItem Header="학습 파이프라인">
                    <MenuItem x:Name="TrainPipelineAnomaThenYoloMenuItem"
                              Header="2단계 (Anoma → YOLO)"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="TrainPipelineAnomaThenYolo_Click"/>
                    <MenuItem x:Name="TrainPipelineAnomaOnlyMenuItem"
                              Header="Anoma만"
                              IsCheckable="True"
                              Click="TrainPipelineAnomaOnly_Click"/>
                    <MenuItem x:Name="TrainPipelineYoloOnlyMenuItem"
                              Header="YOLO만"
                              IsCheckable="True"
                              Click="TrainPipelineYoloOnly_Click"/>
                </MenuItem>

                <MenuItem Header="YOLO 학습 방식">
                    <MenuItem x:Name="YoloTrainFreshMenuItem"
                              Header="YOLO26n 기본 가중치로 새 학습"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="YoloTrainFresh_Click"/>
                    <MenuItem x:Name="YoloTrainFineTuneMenuItem"
                              Header="기존 best.pt로 파인튜닝..."
                              IsCheckable="True"
                              Click="YoloTrainFineTune_Click"/>
                </MenuItem>

                <Separator/>

                <MenuItem Header="현재 파이프라인 학습 실행" 
                          Click="TrainAll_Click"/>

                <MenuItem Header="패키지만 다시 생성" 
                          Click="BuildPackageOnly_Click"/>

                <Separator/>

                <MenuItem Header="모델 관리..."
                          Click="ModelManagement_Click"/>
            </MenuItem>

        </Menu>

        <!-- 메인 영역 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <!-- 좌측 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 데이터 탐색 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#333" Padding="3">
                
                <DockPanel>

                    <TextBlock Text="Dataset"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,5"
                               DockPanel.Dock="Top"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Background="#444">
                        <TextBlock x:Name="TotalCountText" Text="전체 0" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VisibleCountText" Text="필터 후 0" Foreground="#D0D0D0" FontSize="11"/>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock x:Name="UnreviewedCountText" Text="미검수 0" Foreground="#FFD166" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ReviewingCountText" Text="검수 중 0" Foreground="#7FDBFF" FontSize="11"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock x:Name="ConfirmedNormalCountText" Text="정상 확정 0" Foreground="#A0FFA0" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ConfirmedDefectCountText" Text="불량 확정 0" Foreground="#FFA0A0" FontSize="11"/>
                        </WrapPanel>
                        <TextBlock x:Name="ExcludedCountText" Text="학습 제외 0" Foreground="#C0C0C0" FontSize="11"/>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock x:Name="AnomaTrainEligibleCountText" Text="Anoma 학습 0" Foreground="#A0FFA0" FontSize="11" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AnomaEvalEligibleCountText" Text="Anoma 평가 0" Foreground="#FFB3B3" FontSize="11"/>
                        </WrapPanel>
                        <TextBlock x:Name="YoloPositiveEligibleCountText" Text="YOLO 양성 0" Foreground="#80C8FF" FontSize="11"/>
                        <TextBlock x:Name="YoloExcludedNoBoxCountText" Text="YOLO 박스 없는 불량 제외 0" Foreground="#FFCC80" FontSize="11"/>
                        <Button x:Name="RefreshImageListButton"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                HorizontalAlignment="Right"
                                ToolTip="이미지 목록 새로고침"
                                Click="RefreshImageList_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       Text="&#xE72C;"/>
                        </Button>
                    </StackPanel>

                    <Expander DockPanel.Dock="Top"
                              Margin="0,0,0,10"
                              Background="#444"
                              Foreground="White"
                              Header="Filter"
                              IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="이미지명 검색" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <TextBox x:Name="ImageNameFilterTextBox"
                                     Margin="6,2,6,6"
                                     MinWidth="220"
                                     TextChanged="ImageNameFilterTextBox_TextChanged"/>

                            <TextBlock Text="배치" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <ComboBox x:Name="BatchFilterComboBox"
                                      Margin="6,2,6,6"
                                      MinWidth="220"
                                      SelectionChanged="BatchFilterComboBox_SelectionChanged"/>

                            <TextBlock Text="상태" Foreground="#D0D0D0" FontSize="12" Margin="6,6,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="StatusConfirmedNormalCheckBox"
                                          Content="확정 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusConfirmedDefectCheckBox"
                                          Content="확정 불량"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusAiNormalCheckBox"
                                          Content="AI 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="StatusAiDefectCheckBox"
                                          Content="AI 불량"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="불량 유형" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="DefectTypeNormalCheckBox"
                                          Content="정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeDentCheckBox"
                                          Content="찍힘(dent)"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeLooseCheckBox"
                                          Content="풀림(loose)"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="DefectTypeNoLabelCheckBox"
                                          Content="라벨없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="사용자 검수 상태" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="ReviewUnreviewedCheckBox"
                                          Content="미검수"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewReviewingCheckBox"
                                          Content="검수 중"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewConfirmedNormalCheckBox"
                                          Content="정상 확정"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewConfirmedDefectCheckBox"
                                          Content="불량 확정"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="ReviewExcludedCheckBox"
                                          Content="학습 제외"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>

                            <TextBlock Text="데이터 품질" Foreground="#D0D0D0" FontSize="12" Margin="6,0,6,0"/>
                            <WrapPanel Margin="6,2,6,6">
                                <CheckBox x:Name="QualityHealthyCheckBox"
                                          Content="데이터 정상"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingInferCheckBox"
                                          Content="infer 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityInferParseFailedCheckBox"
                                          Content="infer 파싱 실패"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingStateCheckBox"
                                          Content="state 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                                <CheckBox x:Name="QualityMissingRawCheckBox"
                                          Content="raw 없음"
                                          Foreground="White"
                                          Margin="0,0,8,4"
                                          Checked="ImageFilterCheckBox_Changed"
                                          Unchecked="ImageFilterCheckBox_Changed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <ListBox x:Name="ImageListBox"
                             PreviewMouseWheel="ImageListBox_PreviewMouseWheel"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="ImageListBox_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0"
                                        Margin="0,0,0,1"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{Binding ., Converter={StaticResource ImageStatusToColorConverter}}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Vertical" Margin="4">
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="#171717"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding BatchName, StringFormat='배치  {0}'}"
                                                   FontSize="10"
                                                   Foreground="#888888"
                                                   Margin="0,1,0,4"/>
                                        <TextBlock Text="{Binding AiAnomaSummaryText}" FontSize="11" Foreground="#444444"/>
                                        <TextBlock Text="{Binding AiYoloSummaryText}" FontSize="11" Foreground="#444444"/>
                                        <TextBlock Margin="0,3,0,0" FontSize="12">
                                            <Run Text="사용자  "/>
                                            <Run Text="{Binding UserDecisionText}" FontWeight="Bold"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding UserDecisionSourceText}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11">
                                            <Run Text="박스  "/>
                                            <Run Text="{Binding BoxReviewStatusText}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#1B5E20">
                                            <Run Text="학습  "/>
                                            <Run Text="{Binding TrainingEligibilityText}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TrainingExclusionReasonText}"
                                                   FontSize="10"
                                                   Foreground="#A33A00"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                </DockPanel>
            </Border>

            <!-- 중앙: 이미지 뷰어 -->
            <Border Grid.Row="0" Grid.Column="1" Background="#222">
                <ScrollViewer x:Name="ImageScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="ImageCanvas_MouseWheel"
                  SizeChanged="ImageScrollViewer_SizeChanged"
                  ScrollChanged="ImageScrollViewer_ScrollChanged">

                    <Grid x:Name="DisplayGrid" RenderTransformOrigin="0,0">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.LayoutTransform>

                        <Image x:Name="MainImage"
                                   Stretch="None"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                        <Canvas x:Name="ImageCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Width="{Binding ElementName=MainImage, Path=ActualWidth}"
                                    Height="{Binding ElementName=MainImage, Path=ActualHeight}"
                    
                                    PreviewMouseLeftButtonDown="ImageCanvas_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ImageCanvas_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ImageCanvas_PreviewMouseLeftButtonUp"

                                    MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown"
                                    MouseMove="ImageCanvas_MouseMove"
                                    MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 하단: 속성 패널 -->
            <Border Grid.Row="1" Grid.Column="1" Background="#F5F5F5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Class" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ClassComboBox"
                                  SelectionChanged="ClassComboBox_SelectionChanged"
                                  IsEnabled="False"
                                  Width="120">
                            <ComboBoxItem Content="dent"/>
                            <ComboBoxItem Content="loose"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="View" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋" Width="40" Click="ZoomIn_Click"/>
                            <Button Content="－" Width="40" Margin="5,0,0,0" Click="ZoomOut_Click"/>
                            <Button Content="Fit" Width="60" Margin="5,0,0,0" Click="ResetZoom_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Column="2" Header="Anomaly Label" Margin="0,0,18,0">
                        <StackPanel>
                            <RadioButton x:Name="NormalRadio"
                                         Content="Normal"
                                         Checked="NormalRadio_Checked"/>
                            <RadioButton x:Name="AbnormalRadio"
                                         Content="Abnormal"
                                         Checked="AbnormalRadio_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <WrapPanel>
                            <Button x:Name="AcceptAiDecisionButton"
                                    Content="Anoma 판정 수락"
                                    Padding="8,4"
                                    Margin="0,0,6,5"
                                    Click="AcceptAiDecision_Click"/>
                            <Button x:Name="AcceptPredictionBoxesButton"
                                    Content="AI 박스 수락"
                                    Padding="8,4"
                                    Margin="0,0,6,5"
                                    Click="AcceptPredictionBoxes_Click"/>
                            <Button x:Name="ConfirmBoxesButton"
                                    Content="박스 검수 완료"
                                    Padding="8,4"
                                    Margin="0,0,6,5"
                                    Click="ConfirmBoxes_Click"/>
                            <Button x:Name="ExcludeReviewButton"
                                    Content="학습 제외"
                                    Padding="8,4"
                                    Margin="0,0,0,5"
                                    Click="ExcludeFromTraining_Click"/>
                        </WrapPanel>

                        <WrapPanel>
                            <CheckBox x:Name="YoloBackgroundCheckBox"
                                      Content="YOLO 정상 이미지 학습에 포함"
                                      Margin="0,0,14,0"
                                      Checked="YoloBackgroundCheckBox_Changed"
                                      Unchecked="YoloBackgroundCheckBox_Changed"/>
                            <CheckBox x:Name="ShowPredictionCheckBox"
                                      Content="AI 예측 박스 표시"
                                      Margin="0,0,14,0"
                                      IsChecked="True"
                                      Checked="ShowPredictionCheckBox_Checked"
                                      Unchecked="ShowPredictionCheckBox_Unchecked"/>
                            <CheckBox x:Name="ShowRawCheckBox"
                                      Content="Show RAW"
                                      IsChecked="False"
                                      Checked="ShowRawCheckBox_Checked"
                                      Unchecked="ShowRawCheckBox_Unchecked"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>


        </Grid>

    </DockPanel>
</Window>
