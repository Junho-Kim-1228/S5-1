<Window x:Class="CoilTrainingUI.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모델 관리"
        Width="1380"
        Height="740"
        MinWidth="980"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="모델 및 배포 패키지" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="모델을 선택해 성능을 비교하거나 운영에 적용합니다. 운영 적용 시 릴리스 발행과 검증을 자동으로 처리합니다."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            <TextBlock x:Name="RegistryPathText" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock x:Name="CurrentModelText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
            <TextBlock x:Name="ActivationStatusText" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid x:Name="ModelsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="ModelsGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#DCFCE7"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="75"/>
                <DataGridTextColumn Header="생성 시각" Binding="{Binding CreatedAtText}" Width="145"/>
                <DataGridTextColumn Header="모델" Binding="{Binding ModelsText}" Width="210"/>
                <DataGridTextColumn Header="YOLO 성능" Binding="{Binding YoloMetricsText}" Width="310"/>
                <DataGridTextColumn Header="Anoma 성능" Binding="{Binding AnomaMetricsText}" Width="260"/>
                <DataGridTextColumn Header="학습 방식" Binding="{Binding TrainingMode}" Width="85"/>
                <DataGridTextColumn Header="부모 모델" Binding="{Binding ParentText}" Width="170"/>
                <DataGridTextColumn Header="이미지" Binding="{Binding TotalImages}" Width="65"/>
                <DataGridTextColumn Header="원본 배치" Binding="{Binding SourceBatchesText}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <WrapPanel DockPanel.Dock="Left">
                <Button Content="새로고침" Width="88" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button x:Name="CompareModelButton" Content="성능 비교" Width="105" Margin="0,0,8,0" Click="Compare_Click"/>
                <Button x:Name="ApplyModelButton" Content="운영 적용" Style="{StaticResource PrimaryButtonStyle}" Width="110" Margin="0,0,8,0" Click="RequestActivation_Click"/>
                <Button x:Name="CancelActivationButton" Content="대기 요청 취소" Width="110" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelActivation_Click"/>
                <Button x:Name="MoreActionsButton" Content="더보기 ▾" Width="100" Click="MoreActions_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="기존 운영 패키지 가져오기..." Click="ImportExistingPackage_Click"/>
                            <Separator/>
                            <MenuItem Header="비교 기준으로 지정" Click="SetReference_Click"/>
                            <MenuItem Header="이 모델로 파인튜닝" Click="FineTune_Click"/>
                            <MenuItem Header="보관" Click="Archive_Click"/>
                            <Separator/>
                            <MenuItem Header="릴리스만 발행/검증" Click="PublishRelease_Click"/>
                            <MenuItem Header="패키지 열기" Click="OpenPackage_Click"/>
                            <MenuItem Header="Run 폴더 열기" Click="OpenRun_Click"/>
                            <Separator/>
                            <MenuItem Header="직접 폴더 배포..." Click="Deploy_Click" ToolTip="장애 복구용 고급 기능"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
            <Button Content="닫기" Width="80" HorizontalAlignment="Right" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
