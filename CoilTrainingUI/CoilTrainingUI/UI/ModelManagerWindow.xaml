<Window x:Class="CoilTrainingUI.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모델 관리"
        Width="1380"
        Height="740"
        MinWidth="980"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="모델 및 배포 패키지" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="대표 모델을 비교 기준으로 지정하고, 검증된 패키지를 명시적으로 추론 UI에 배포할 수 있습니다."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            <TextBlock x:Name="RegistryPathText" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <DataGrid x:Name="ModelsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="75"/>
                <DataGridTextColumn Header="생성 시각" Binding="{Binding CreatedAtText}" Width="145"/>
                <DataGridTextColumn Header="모델" Binding="{Binding ModelsText}" Width="210"/>
                <DataGridTextColumn Header="YOLO 성능" Binding="{Binding YoloMetricsText}" Width="310"/>
                <DataGridTextColumn Header="Anoma 성능" Binding="{Binding AnomaMetricsText}" Width="260"/>
                <DataGridTextColumn Header="학습 방식" Binding="{Binding TrainingMode}" Width="85"/>
                <DataGridTextColumn Header="부모 모델" Binding="{Binding ParentText}" Width="170"/>
                <DataGridTextColumn Header="이미지" Binding="{Binding TotalImages}" Width="65"/>
                <DataGridTextColumn Header="원본 배치" Binding="{Binding SourceBatchesText}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="새로고침" Width="88" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="대표 모델로 지정" Style="{StaticResource PrimaryButtonStyle}" Width="125" Margin="0,0,8,0" Click="SetReference_Click"/>
                <Button Content="보관" Width="72" Margin="0,0,8,0" Click="Archive_Click"/>
                <Button Content="대표 모델과 비교" Width="125" Margin="0,0,8,0" Click="Compare_Click"/>
                <Button Content="이 모델로 파인튜닝" Width="140" Margin="0,0,8,0" Click="FineTune_Click"/>
                <Button Content="추론 UI에 배포..." Style="{StaticResource PrimaryButtonStyle}" Width="125" Margin="0,0,8,0" Click="Deploy_Click"/>
                <Button Content="패키지 열기" Width="95" Margin="0,0,8,0" Click="OpenPackage_Click"/>
                <Button Content="Run 폴더 열기" Width="100" Click="OpenRun_Click"/>
            </StackPanel>
            <Button Content="닫기" Width="80" HorizontalAlignment="Right" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
