{
  "PythonExe": "",
  "YoloPythonExe": "python_env_yolo\\Scripts\\python.exe",
  "AnomaPythonExe": "python_env_dinomaly\\Scripts\\python.exe",
  "BatchLibraryRoot": "",
  "AiProjectRoot": "coil-ai-runtime",
  "Workspace": {
    "TrainRatio": 0.8,
    "ValRatio": 0.2,
    "Seed": 42,
    "YoloBackgroundToPositiveRatio": 1.0,
    "YoloOversampleClass": "",
    "YoloOversampleFactor": 1.0,
    "YoloAugmentClass": "all",
    "YoloAugmentFactor": 2.0
  },

  "YoloTraining": {
    "Model": "yolo26n.pt",
    "Epochs": 100,
    "FineTuneEpochs": 40,
    "FineTuneLearningRate": 0.001,
    "ImageSize": 1280,
    "Batch": 4,
    "Device": "auto",
    "Seed": 0
  },

  "AnomaTraining": {
    "Model": "dinomaly",
    "ImageSize": 448,
    "Batch": 4,
    "Device": "auto",
    "Seed": 42,
    "Encoder": "vit_large_patch14_reg4_dinov2",
    "Dropout": 0.1,
    "DecoderDepth": 12,
    "MaxSteps": 5000,
    "LearningRate": 0.002,
    "TargetRecall": 0.9
  },

  "YoloInfer": {
    "ImgSz": 1280,
    "Letterbox": true,
    "ConfThres": 0.25,
    "IouThres": 0.45,
    "MaxDet": 300
  },

  "AnomaInfer": {
    "Mode": "stretch",
    "InputSize": 448,
    "ScoreThres": 0.02454194,
    "CropPaddingPx": 0
  },

  "AutoReview": {
    "Enabled": true,
    "PolicyVersion": "auto_review_v2_no_audit",
    "AnomaNormalThresholdMultiplier": 0.95,
    "AnomaDefectThresholdMultiplier": 1.6,
    "YoloBoxMinConfidence": 0.85,
    "AuditSampleRate": 0.0
  },

  "MaskInfer": {
    "ModelPath": "outputs/mask/coil_unetpp_effb4_scratch_v8/mask.onnx",
    "InputSize": 512,
    "ResizeMode": "letterbox",
    "ImageMean": [0.485, 0.456, 0.406],
    "ImageStd": [0.229, 0.224, 0.225],
    "ConfidencePercentile": 99.5,
    "ConfidenceThreshold": 0.5,
    "MaskThreshold": 0.3,
    "MinComponentArea": 64,
    "MorphOpenKernel": 0,
    "MorphCloseKernel": 0,
    "OuterRecoverKernel": 0,
    "KeepLargestComponent": true,
    "PreserveInnerHoles": true,
    "MinHoleArea": 64
  },

  "Automation": {
    "Enabled": false,
    "ExchangeRoot": "",
    "AutoImportBatches": true,
    "AutoPublishModels": true,
    "AutoApplyApprovedModels": true,
    "ReconcileIntervalSeconds": 10
  }
}
