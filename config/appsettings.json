{
  "PythonExe": "",
  "Scripts": {
    "YoloTrain": "scripts\\train_yolo.py",
    "AnomaTrain": "scripts\\train_anoma.py"
  },
  "Workspace": {
    "TrainRatio": 0.8,
    "ValRatio": 0.2,
    "Seed": 42,
    "UseRoiProcessedImages": true
  },

  "YoloInfer": {
    "ImgSz": 1024,
    "Letterbox": true,
    "ConfThres": 0.25,
    "IouThres": 0.45,
    "MaxDet": 300
  },

  "AnomaInfer": {
    "Mode": "crop",
    "InputSize": 256,
    "ScoreThres": 0.5,
    "CropPaddingPx": 8
  },

  "Fusion": {
    "Rule": "AND",
    "YoloThreshold": 0.25,
    "AnomaThreshold": 0.5
  }
}
